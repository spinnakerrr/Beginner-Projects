def load_my_poetry():

    if not os.path.exists(POETRY_FILE):

        return []

    try:

        with open(
            POETRY_FILE,
            "r",
            encoding="utf-8"
        ) as file:

            content = file.read()

    except Exception as error:

        print(
            f"Could not read poetry archive: {error}"
        )

        return []

    poems = [

        poem.strip()

        for poem in content.split("---")

        if poem.strip()

    ]

    return poems


# ============================================================
# PERSONAL POETRY ANTI-REPETITION
# ============================================================

POETRY_RECENT_LIMIT = 15

recent_poetry = deque(
    maxlen=POETRY_RECENT_LIMIT
)


def get_my_poetry():

    poems = load_my_poetry()

    if not poems:

        return (
            "🐕 CORGIBOT NOTICE\n\n"
            "The 21CR Archive is currently empty.\n\n"
            "Add some writing to:\n\n"
            "my_poetry.txt"
        )

    available = [
        poem
        for poem in poems
        if poem not in recent_poetry
    ]

    if not available:

        available = poems

    selected = random.choice(
        available
    )

    recent_poetry.append(
        selected
    )

    return (
        "📖 FROM THE 21CR ARCHIVE\n\n"
        + selected
    )


