async def post_init(
    application: Application
):

    if application.job_queue is None:

        print(
            "WARNING: JobQueue is not available."
        )

        print(
            'Install it with: '
            'python -m pip install '
            '"python-telegram-bot[job-queue]"'
        )

        return

    # ========================================================
    # YOUR 21CR CHAT ID
    # ========================================================

    CHAT_ID = "ENTER CHAT ID HERE"

    application.bot_data[
        "chat_id"
    ] = CHAT_ID

    if CHAT_ID is None:

        print(
            "Automatic posting is disabled "
            "until CHAT_ID is configured."
        )

        return

    # ========================================================
    # MORNING
    # ========================================================

    application.job_queue.run_daily(
        automatic_post,
        time=MORNING_TIME,
        name="morning_corgi",
    )

    # ========================================================
    # EVENING
    # ========================================================

    application.job_queue.run_daily(
        automatic_post,
        time=EVENING_TIME,
        name="evening_corgi",
    )

    # ========================================================
    # NIGHT
    # ========================================================

    application.job_queue.run_daily(
        automatic_post,
        time=NIGHT_TIME,
        name="night_corgi",
    )

    print(
        "Automatic Corgibot posting scheduled:"
    )

    print("09:00")
    print("19:00")
    print("23:00")


