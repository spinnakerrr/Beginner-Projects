async def automatic_post(
    context: ContextTypes.DEFAULT_TYPE,
):

    chat_id = context.application.bot_data.get(
        "chat_id"
    )

    if not chat_id:

        print(
            "Automatic post skipped: "
            "no CHAT_ID configured."
        )

        return

    message = get_general_item()

    try:

        await context.bot.send_message(
            chat_id=chat_id,
            text=message,
        )

        print(
            "Automatic post sent at "
            + datetime.datetime.now().strftime(
                "%Y-%m-%d %H:%M:%S"
            )
        )

    except Exception as error:

        print(
            f"Automatic post failed: {error}"
        )


