RECENT_LIMIT = 15

recent_items = defaultdict(
    lambda: deque(
        maxlen=RECENT_LIMIT
    )
)


def get_random_item(category):

    items = CONTENT.get(
        category,
        []
    )

    if not items:

        return (
            "Corgibot has temporarily "
            "misplaced its thoughts. 🐕"
        )

    recent = recent_items[category]

    available = [
        item
        for item in items
        if item not in recent
    ]

    if not available:

        available = items

    selected = random.choice(
        available
    )

    recent.append(
        selected
    )

    return selected


